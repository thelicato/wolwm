# IANA time zone used for new scheduled wake-ups.
# Examples: Europe/Rome, America/New_York, Asia/Tokyo
WOLWM_TIMEZONE=UTC

# Minimum wait between wake requests for the same device.
WOLWM_WAKE_COOLDOWN_SECONDS=10

# Persistent application data directory for manual installations.
# Docker Compose stores data in ./wolwm_data and uses /wolwm in the container.
WOLWM_DATA_FOLDER=./wolwm_data
